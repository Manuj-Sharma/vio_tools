Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 420
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Own-survey mosaic (map)
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Path
      Name: FC position (EKF, truth for scoring)
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 255; 255; 255
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 1.2
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/path_fc
      Value: true
    - Class: rviz_default_plugins/Path
      Name: VIO (OpenVINS, online aligned)
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 235; 104; 52
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 1.2
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/path_vio
      Value: true
    - Class: rviz_default_plugins/Path
      Name: VIO + map matcher
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 42; 120; 214
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 1.2
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/path_corrected
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM features (3D)
      Enabled: true
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
      Axis: Z
      Channel Name: intensity
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 7
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/feat_slam
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: MSCKF features (3D)
      Enabled: true
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
      Axis: Z
      Channel Name: intensity
      Color: 252; 175; 62
      Color Transformer: FlatColor
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/feat_msckf
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: ArUco features
      Enabled: true
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
      Axis: Z
      Channel Name: intensity
      Color: 173; 127; 168
      Color Transformer: FlatColor
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 8
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/feat_aruco
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Positions, search window, error
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/markers
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera mosaic | map patch
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mm/mosaic_vs_map
      Value: true
    - Class: rviz_default_plugins/Image
      Name: OpenVINS feature tracks
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ov_msckf/trackhist
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D orbit
      Distance: 330
      Focal Point:
        X: -10
        Y: 70
        Z: 30
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: -1.2
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Top-down (north up)
        Near Clip Distance: 0.01
        Scale: 9
        Invert Z Axis: false
        Angle: 0
        X: -20
        Y: 75
      - Class: rviz_default_plugins/Orbit
        Name: 3D orbit
        Distance: 330
        Focal Point:
          X: -10
          Y: 70
          Z: 30
        Focal Shape Fixed Size: false
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Near Clip Distance: 0.01
        Pitch: 0.55
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz_default_plugins)
        Yaw: -1.2
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
  X: 60
  Y: 30
